diff --git a/bsd/dev/ArmSmmu4K.h b/bsd/dev/ArmSmmu4K.h
new file mode 100644
index 0000000..1b09a29
--- /dev/null
+++ b/bsd/dev/ArmSmmu4K.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_H
+#define ARM_SMMU_4K_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    ArmSmmu4KSuccess = 0, ArmSmmu4KArgument, ArmSmmu4KBadRange,
+    ArmSmmu4KOverlap, ArmSmmu4KCapacity, ArmSmmu4KBudget,
+    ArmSmmu4KUnsupported, ArmSmmu4KStateMismatch,
+    ArmSmmu4KIoError, ArmSmmu4KTimeout, ArmSmmu4KBusy, ArmSmmu4KFault
+} ArmSmmu4KStatus;
+typedef struct {
+    unsigned input_bits;           /* 32..48, low-address TTBR0 profile. */
+    unsigned output_bits;          /* 32,36,40,42,44,48. */
+    uint64_t table_physical;        /* Caller-owned contiguous pool, aligned 4K. */
+    size_t leaf_budget;            /* Explicit upper bound on mapping work. */
+} ArmSmmu4KConfig;
+enum {ArmSmmu4KRead=1,ArmSmmu4KWrite=2,ArmSmmu4KExecute=4,ArmSmmu4KPrivileged=8};
+typedef struct {
+    uint64_t iova, physical, bytes;
+    unsigned permissions;          /* Read required; optional Write/Execute/Privileged. */
+    unsigned writeback;            /* 0=normal NC, 1=normal WB/WA. */
+    unsigned shareability;         /* 2=outer, 3=inner; explicit, no default. */
+} ArmSmmu4KRange;
+typedef struct {
+    uint64_t root_physical;
+    uint64_t mair;                 /* NC at index 0, WB/WA at index 1. */
+    size_t table_pages, leaf_pages;
+    unsigned start_level;
+    unsigned upper_region;        /* 0=Build TTBR0, 1=BuildUpper TTBR1. */
+} ArmSmmu4KResult;
+
+/* Build inactive ARM LPAE stage-1 tables with ONLY 4K level-3 leaves.
+ * Sorted disjoint low IOVA ranges; no sign extension or input conversion.
+ * No resource may map the table pool. Conflicting cache/shareability/privilege
+ * aliases refuse. Default 1/3 retains unprivileged PXN/UXN behavior. Execute
+ * and Privileged explicitly describe DEVICE-stage1 accesses (e.g. firmware),
+ * never CPU permissions or authorization to execute unauthenticated images.
+ * All validation/capacity checks precede table writes. Failure zeros result
+ * and leaves tables untouched. Success writes only result.table_pages pages.
+ * Caller guarantees real accessible, disjoint storage, immutable inputs,
+ * native-endian uint64_t table storage aligned to at least 8 bytes, actual
+ * physical ownership and matching CPU attributes/cache maintenance.
+ * NO MMIO, allocation, barriers, TLB operations or activation. This does NOT
+ * prove hardware support, coherent walks or a live isolated GPU context. */
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+/* Same native 4K format for TTBR1's upper, sign-extended address region.
+ * IOVAs must already be in [2^64-2^input_bits,2^64); truncated low addresses
+ * refuse. Uses the architectural partial-root index width. No lower-region
+ * remapping, page-size conversion, MMIO or translation activation occurs. */
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/ArmSmmu4K.c b/bsd/dev/ArmSmmu4K.c
new file mode 100644
index 0000000..be5f302
--- /dev/null
+++ b/bsd/dev/ArmSmmu4K.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4K.h"
+#define PAGE_BYTES UINT64_C(4096)
+#define ADDRESS_MASK UINT64_C(0x0000fffffffff000)
+
+static ArmSmmu4KStatus build_region(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result, unsigned upper)
+{
+    if (!result) return ArmSmmu4KArgument;
+    result->root_physical = result->mair = 0;
+    result->table_pages = result->leaf_pages = result->start_level = 0;
+    result->upper_region = 0;
+    if (!config || !ranges || !range_count || !tables || !capacity ||
+        capacity > SIZE_MAX / PAGE_BYTES || range_count > SIZE_MAX / sizeof(*ranges) ||
+        config->input_bits < 32 || config->input_bits > 48 ||
+        !(config->output_bits == 32 || config->output_bits == 36 || config->output_bits == 40 ||
+          config->output_bits == 42 || config->output_bits == 44 || config->output_bits == 48) ||
+        !config->leaf_budget || config->leaf_budget > (SIZE_MAX - 1) / 3 ||
+        ((uintptr_t)tables & 7)) return ArmSmmu4KArgument;
+    if (range_count > config->leaf_budget) return ArmSmmu4KBudget;
+    uint64_t input_limit = UINT64_C(1) << config->input_bits;
+    uint64_t output_limit = UINT64_C(1) << config->output_bits;
+    uint64_t pool_bytes = (uint64_t)capacity * PAGE_BYTES;
+    uint64_t pool = config->table_physical;
+    if ((pool & 4095) || pool >= output_limit || pool_bytes > output_limit - pool)
+        return ArmSmmu4KBadRange;
+    size_t leaves = 0;
+    uint64_t previous_end = 0;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        if (!r->bytes || ((r->iova | r->physical | r->bytes) & 4095) ||
+            (!(r->permissions & ArmSmmu4KRead) || (r->permissions & ~15u)) || r->writeback > 1 || (r->shareability != 2 && r->shareability != 3) ||
+            r->physical >= output_limit || r->bytes > output_limit - r->physical)
+            return ArmSmmu4KBadRange;
+        if (upper ? (r->iova < UINT64_MAX-input_limit+1 || r->bytes-1 > UINT64_MAX-r->iova) :
+                    (r->iova >= input_limit || r->bytes > input_limit-r->iova))
+            return ArmSmmu4KBadRange;
+        if (i && r->iova <= previous_end) return ArmSmmu4KOverlap;
+        previous_end = r->iova + (r->bytes-1);
+        if (r->physical < pool + pool_bytes && pool < r->physical + r->bytes)
+            return ArmSmmu4KOverlap;
+        for (size_t j = 0; j < i; ++j) {
+            if ((r->writeback != ranges[j].writeback || r->shareability != ranges[j].shareability || ((r->permissions ^ ranges[j].permissions) & ArmSmmu4KPrivileged)) && r->physical < ranges[j].physical + ranges[j].bytes &&
+                ranges[j].physical < r->physical + r->bytes) return ArmSmmu4KOverlap;
+        }
+        uint64_t pages = r->bytes / PAGE_BYTES;
+        if (pages > config->leaf_budget - leaves) return ArmSmmu4KBudget;
+        leaves += (size_t)pages;
+    }
+    /* Each range has at least one leaf, so the validated leaf budget also
+     * bounds the range/alias loops. Sorted IOVAs make prefix counting exact. */
+    unsigned levels = (config->input_bits - 12 + 8) / 9;
+    unsigned start = 4 - levels;
+    size_t required = 1;
+    uint64_t last[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
+    for (size_t i = 0; i < range_count; ++i) {
+        for (uint64_t offset = 0; offset < ranges[i].bytes; offset += PAGE_BYTES) {
+            uint64_t va = ranges[i].iova + offset;
+            for (unsigned level = start; level < 3; ++level) {
+                uint64_t prefix = va >> (39 - 9 * level);
+                if (prefix != last[level]) { ++required; last[level] = prefix; }
+            }
+        }
+    }
+    if (required > capacity) return ArmSmmu4KCapacity;
+    for (size_t i = 0; i < required * 512; ++i) tables[i] = 0;
+    size_t next = 1;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        uint64_t attributes = (1u << 11) | (1u << 10) | 3;
+        if (!(r->permissions & ArmSmmu4KExecute)) attributes |= UINT64_C(3) << 53;
+        if (!(r->permissions & ArmSmmu4KPrivileged)) attributes |= 1u << 6;
+        if (!(r->permissions & ArmSmmu4KWrite)) attributes |= 1u << 7;
+        attributes |= (uint64_t)r->shareability << 8;
+        if (r->writeback) attributes |= 1u << 2;
+        for (uint64_t offset = 0; offset < r->bytes; offset += PAGE_BYTES) {
+            uint64_t va = r->iova + offset;
+            size_t table = 0;
+            for (unsigned level = start; level < 3; ++level) {
+                unsigned shift = 39-9*level;
+                unsigned width = level==start ? config->input_bits-shift : 9;
+                size_t slot = table * 512 + ((va >> shift) & ((1u<<width)-1));
+                if (!tables[slot]) tables[slot] = (pool + PAGE_BYTES * next++) | 3;
+                table = (size_t)(((tables[slot] & ADDRESS_MASK) - pool) / PAGE_BYTES);
+            }
+            tables[table * 512 + ((va >> 12) & 511)] = (r->physical + offset) | attributes;
+        }
+    }
+    result->root_physical = pool;
+    result->mair = 0xff44;
+    result->table_pages = required;
+    result->leaf_pages = leaves;
+    result->start_level = start;
+    result->upper_region = upper;
+    return ArmSmmu4KSuccess;
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,0);
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,1);
+}
diff --git a/bsd/dev/ArmSmmu4KContext.h b/bsd/dev/ArmSmmu4KContext.h
new file mode 100644
index 0000000..3c2faa4
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KContext.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_CONTEXT_H
+#define ARM_SMMU_4K_CONTEXT_H
+#include "ArmSmmu4K.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    /* A config/result pair from Build, BuildUpper or LivePrepare; NULL pair disables it.
+     * A live arena may have zero mapped leaves while retaining its table topology.
+     * Both enabled regions need distinct physical pools and equal OAS/MAIR.
+     * The trusted caller retains actual pool ownership and immutable results. */
+    const ArmSmmu4KConfig *lower, *upper;
+    const ArmSmmu4KResult *lower_tables, *upper_tables;
+    uint32_t id0, id2;       /* Raw SMMUv2 identification register values. */
+    unsigned asid;          /* 0..65535, ownership managed by the caller. */
+    unsigned coherent_walk; /* Explicit: 1=inner WBWA, 0=outer NC. */
+    unsigned stall_on_fault, continue_after_fault; /* Each 0 or 1. */
+} ArmSmmu4KContextConfig;
+typedef struct {
+    uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+    uint64_t ttbr0, ttbr1;
+} ArmSmmu4KContextImage;
+
+/* Encode AArch64 stage1, stage2-bypass native4K SMMUv2 context registers.
+ * Capability/width/result/refusal checks precede publishing an image. Failure
+ * zeros it. Both TG0/TG1 select 4K even for a disabled region. No MMIO, power,
+ * stream/context assignment, cache barriers, TLB operations or activation.
+ * ID inputs are not proof that the caller read actual hardware. Inputs,
+ * their pointed-to configs/results, and output must be disjoint and immutable
+ * throughout the call; this is a trusted kernel integration boundary. */
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *,
+    ArmSmmu4KContextImage *);
+/* Compare all supplied readback fields with the freshly encoded expected
+ * image. Caller must read real hardware and independently walk its actual
+ * TTBR tables, verify ownership/coherency and handle faults/TLB lifetime.
+ * Matching caller-supplied values alone never qualify an active GPU mapping. */
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KContextImage *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/ArmSmmu4KContext.c b/bsd/dev/ArmSmmu4KContext.c
new file mode 100644
index 0000000..2cc334e
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KContext.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KContext.h"
+static int width_code(unsigned bits)
+{
+    switch(bits) {case 32:return 0;case 36:return 1;case 40:return 2;
+        case 42:return 3;case 44:return 4;case 48:return 5;default:return -1;}
+}
+static unsigned width_bits(unsigned code)
+{
+    switch(code) {case 0:return 32;case 1:return 36;case 2:return 40;
+        case 3:return 42;case 4:return 44;case 5:return 48;default:return 0;}
+}
+static int region_valid(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *r,unsigned upper)
+{
+    if(!c || !r)return !c && !r;
+    if(c->input_bits<32 || c->input_bits>48 || width_code(c->output_bits)<0 ||
+        (c->table_physical&4095) || r->root_physical!=c->table_physical ||
+        r->mair!=0xff44 || r->upper_region!=upper || !r->table_pages ||
+        r->leaf_pages>c->leaf_budget || r->table_pages>UINT64_MAX/4096 ||
+        r->start_level!=4-(c->input_bits-12+8)/9)return 0;
+    uint64_t limit=UINT64_C(1)<<c->output_bits;
+    return r->root_physical<limit && (uint64_t)r->table_pages*4096<=limit-r->root_physical;
+}
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *c,
+    ArmSmmu4KContextImage *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    out->cbar=out->cba2r=out->tcr=out->tcr2=out->mair0=out->mair1=out->sctlr=0;
+    out->reserved_zero=0;
+    out->ttbr0=out->ttbr1=0;
+    if(!c || (!c->lower && !c->upper) || c->asid>65535 || c->coherent_walk>1 ||
+        c->stall_on_fault>1 || c->continue_after_fault>1 ||
+        !region_valid(c->lower,c->lower_tables,0) || !region_valid(c->upper,c->upper_tables,1))return ArmSmmu4KArgument;
+    unsigned va=width_bits((c->id2>>8)&15),pa=width_bits((c->id2>>4)&15);
+    if(!(c->id0&(UINT32_C(1)<<30)) || !(c->id2&(1u<<12)) || !va || !pa)return ArmSmmu4KUnsupported;
+    const ArmSmmu4KConfig *basis=c->lower?c->lower:c->upper;
+    if(basis->output_bits>pa || (c->lower && c->lower->input_bits>va) ||
+        (c->upper && (c->upper->input_bits>va || c->upper->output_bits!=basis->output_bits)))return ArmSmmu4KUnsupported;
+    if(c->lower && c->upper) {
+        const ArmSmmu4KResult *a=c->lower_tables,*b=c->upper_tables;
+        if(a->root_physical<b->root_physical+(uint64_t)b->table_pages*4096 &&
+           b->root_physical<a->root_physical+(uint64_t)a->table_pages*4096)return ArmSmmu4KOverlap;
+    }
+    ArmSmmu4KContextImage v;
+    v.cbar=0x1f300; /* Stage1 translation, stage2 bypass; weakest bypass attrs. */
+    v.cba2r=1;      /* AArch64. No stage2 VMID or guest translation. */
+    v.tcr=UINT32_C(2)<<30; /* TG1=4K, TG0=4K. */
+    unsigned walk=c->coherent_walk?0x3500:0x2000;
+    if(c->lower)v.tcr|=walk|(64-c->lower->input_bits);
+    else v.tcr|=1u<<7; /* EPD0 */
+    if(c->upper)v.tcr|=(walk|(64-c->upper->input_bits))<<16;
+    else v.tcr|=1u<<23; /* EPD1 */
+    v.tcr2=(7u<<15)|(1u<<4)|(unsigned)width_code(basis->output_bits);
+    v.ttbr0=(uint64_t)c->asid<<48;v.ttbr1=v.ttbr0;
+    if(c->lower)v.ttbr0|=c->lower_tables->root_physical;
+    if(c->upper)v.ttbr1|=c->upper_tables->root_physical;
+    v.mair0=0xff44;v.mair1=0;
+    v.sctlr=0x1067|(c->stall_on_fault<<7)|(c->continue_after_fault<<8);
+    v.reserved_zero=0;
+    *out=v;
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KContextImage *observed)
+{
+    if(!observed)return ArmSmmu4KArgument;
+    ArmSmmu4KContextImage expected;
+    ArmSmmu4KStatus status=ArmSmmu4KEncodeContext(c,&expected);
+    if(status!=ArmSmmu4KSuccess)return status;
+    /* TCR2.TBI0/TBI1 (bits 5/6, top-byte ignore) are written 0 but may read 1: the sheng Adreno MMU-500 reads
+     * 0x38071 for 0x38011 (int-008). Linux neither sets nor reads them back. With a 48-bit upstream bus the top
+     * byte of a device address is zero, so ignoring it changes no translation. Only 0 -> 1 is accepted here. */
+    const uint32_t tbi_set=observed->tcr2&~expected.tcr2&UINT32_C(0x60);
+    /* SCTLR.ASIDPNE (bit 12) is written 1 but may read 0: the same SMMU reads 0x167 for 0x1167 (int-009). Linux
+     * writes it and never reads it back. A shared ASID namespace is safe because every bank's ASID is the
+     * caller's exclusive lease. Only 1 -> 0 is accepted. */
+    const uint32_t asidpne_clear=expected.sctlr&~observed->sctlr&UINT32_C(0x1000);
+    if(expected.cbar!=observed->cbar || expected.cba2r!=observed->cba2r ||
+        expected.tcr!=observed->tcr || ((expected.tcr2^observed->tcr2)&~tbi_set) ||
+        expected.mair0!=observed->mair0 || expected.mair1!=observed->mair1 ||
+        ((expected.sctlr^observed->sctlr)&~asidpne_clear) || observed->reserved_zero || expected.ttbr0!=observed->ttbr0 ||
+        expected.ttbr1!=observed->ttbr1)return ArmSmmu4KStateMismatch;
+    return ArmSmmu4KSuccess;
+}
diff --git a/bsd/dev/ArmSmmu4KProgram.h b/bsd/dev/ArmSmmu4KProgram.h
new file mode 100644
index 0000000..25ccf6d
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KProgram.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_PROGRAM_H
+#define ARM_SMMU_4K_PROGRAM_H
+#include "ArmSmmu4KContext.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Byte offsets are relative to one real, owned SMMUv2 MMIO mapping. All I/O
+ * callbacks return 0 on success. read/write64 must perform actual aligned
+ * 64-bit TTBR accesses; barrier orders table visibility and device writes.
+ * A barrier is NOT cache cleaning. No callback may silently fake success. */
+typedef struct {
+    void *cookie;
+    size_t register_bytes;
+    int (*read32)(void *,size_t,uint32_t *);
+    int (*read64)(void *,size_t,uint64_t *);
+    int (*write32)(void *,size_t,uint32_t);
+    int (*write64)(void *,size_t,uint64_t);
+    int (*barrier)(void *);
+} ArmSmmu4KIo;
+typedef struct {
+    uint64_t context_offset;
+    uint32_t id0,id1,id2,phase,writes,poll_reads,fault_status;
+    uint32_t readback_valid,enabled,disabled_verified,tlb_synchronized,must_retain_tables;
+    ArmSmmu4KContextImage readback;
+} ArmSmmu4KProgramResult;
+
+/* REAL register programming primitive, not a device-discovery/ownership layer.
+ * Caller MUST hold an exclusive bank/ASID/stream lease, keep the device powered
+ * and clocked, quiesce/fault its streams, install its fault interrupt handler,
+ * establish platform ACTLR/security requirements, and clean/publish real owned
+ * native4K tables before calling. Every argument/result must be disjoint.
+ * Reads actual ID0/ID1/ID2 through I/O and overrides config's supplied IDs.
+ * Refuses enabled banks before any write. Enables SCTLR only after register
+ * readback and bounded ASID invalidation/synchronization. No global reset,
+ * stream reassignment or other bank is touched. On failure attempts disable
+ * and sync; must_retain_tables stays set unless both are confirmed. Success
+ * also retains table ownership while the installed context is active.
+ * This does not walk tables or establish actual GPU execution/correctness. */
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Read-only observation of actual IDs and all owned context registers. Requires
+ * exact enabled native4K image and no pending context fault. Does not walk the
+ * physical tables or establish ownership. Readback is a momentary observation;
+ * callers retain resources, quiescence/exclusive lease and fault handling. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KProgramResult *);
+/* Publish already cleaned descriptor changes with a real ASID invalidation
+ * and bounded context TLBSYNC. Observe the complete enabled native4K image and
+ * faults before and after. Caller exclusively owns this bank/ASID, serializes
+ * all page-table updates and keeps every master quiesced. A barrier is not a
+ * cache clean. No SCTLR/TTBR/stream writes or recovery/reset are performed.
+ * Any failure retains all mappings/resources; success is not a GPU fence. */
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* TLBIASID (or, with all set, TLBIALL) and the bounded TLBSYNC of the context bank at context_offset alone: no image or fault
+ * observation. For a caller that observed this owned bank's image at that offset already and keeps it owned (the live updater
+ * between its whole-verification updates). */
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* As ArmSmmu4KSynchronizeOwnedContext, but with TLBIALL for the bank instead of TLBIASID: every cached translation of the bank goes,
+ * whatever ASID it was tagged with. */
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Disable only if actual stage/format/roots/ASID/attributes still match the
+ * expected owned context. Retain bank, mappings and tables on any uncertainty.
+ * Does not release the caller's lease or power/stream/interrupt resources. */
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/ArmSmmu4KProgram.c b/bsd/dev/ArmSmmu4KProgram.c
new file mode 100644
index 0000000..2cb6695
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KProgram.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KProgram.h"
+#define FSR_FAULT UINT32_C(0xc00001fe)
+static int read_image(const ArmSmmu4KIo *io,size_t gr1,size_t cb,unsigned bank,
+    ArmSmmu4KContextImage *v)
+{
+    v->reserved_zero=0;
+    return io->read32(io->cookie,gr1+bank*4,&v->cbar) ||
+        io->read32(io->cookie,gr1+0x800+bank*4,&v->cba2r) ||
+        io->read32(io->cookie,cb+0x30,&v->tcr) ||
+        io->read32(io->cookie,cb+0x10,&v->tcr2) ||
+        io->read64(io->cookie,cb+0x20,&v->ttbr0) ||
+        io->read64(io->cookie,cb+0x28,&v->ttbr1) ||
+        io->read32(io->cookie,cb+0x38,&v->mair0) ||
+        io->read32(io->cookie,cb+0x3c,&v->mair1) ||
+        io->read32(io->cookie,cb,&v->sctlr);
+}
+static int write32(const ArmSmmu4KIo *io,size_t at,uint32_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write32(io->cookie,at,value);
+}
+static int write64(const ArmSmmu4KIo *io,size_t at,uint64_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write64(io->cookie,at,value);
+}
+/* TLBIASID (+0x610, value = ASID) or, with all set, TLBIALL (+0x618, value ignored), then TLBSYNC/TLBSTATUS. */
+static ArmSmmu4KStatus sync_tlb(const ArmSmmu4KIo *io,size_t cb,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->tlb_synchronized=0;
+    if(io->barrier(io->cookie) || write32(io,cb+(all?0x618:0x610),all?0:asid,r) ||
+        write32(io,cb+0x7f0,UINT32_MAX,r) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    for(unsigned i=0;i<budget;++i) {
+        uint32_t status;++r->poll_reads;
+        if(io->read32(io->cookie,cb+0x7f4,&status))return ArmSmmu4KIoError;
+        if(!(status&1)) {
+            /* Order the completed device observation before callers recycle
+             * normal-memory tables or publish subsequent context work. */
+            if(io->barrier(io->cookie))return ArmSmmu4KIoError;
+            r->tlb_synchronized=1;return ArmSmmu4KSuccess;
+        }
+    }
+    return ArmSmmu4KTimeout;
+}
+static ArmSmmu4KStatus sync_asid(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    return sync_tlb(io,cb,asid,0,budget,r);
+}
+static ArmSmmu4KStatus disable_sync(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->must_retain_tables=1;r->disabled_verified=0;
+    uint32_t value;
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) || io->read32(io->cookie,cb,&value))return ArmSmmu4KIoError;
+    if(value)return ArmSmmu4KStateMismatch;
+    r->disabled_verified=1;r->enabled=0;
+    ArmSmmu4KStatus status=sync_asid(io,cb,asid,budget,r);
+    if(status==ArmSmmu4KSuccess)r->must_retain_tables=0;
+    return status;
+}
+static ArmSmmu4KStatus prepare(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r,
+    ArmSmmu4KContextConfig *actual,ArmSmmu4KContextImage *image,size_t *gr1)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};
+    r->must_retain_tables=1;
+    if(!io || !config || !io->read32 || !io->read64 || !io->write32 || !io->write64 ||
+        !io->barrier || io->register_bytes<0x2c || !budget || budget>1048576 || bank>255)return ArmSmmu4KArgument;
+    r->phase=1;
+    if(io->read32(io->cookie,0x20,&r->id0) || io->read32(io->cookie,0x24,&r->id1) ||
+        io->read32(io->cookie,0x28,&r->id2))return ArmSmmu4KIoError;
+    unsigned shift=(r->id1>>31)?16:12;
+    size_t pages=(size_t)1<<(((r->id1>>28)&7)+1);
+    size_t stride=(size_t)1<<shift;
+    unsigned banks=r->id1&255,s2=(r->id1>>16)&255;
+    if(!banks || banks>pages || s2>banks || bank<s2 || bank>=banks ||
+        io->register_bytes<2*pages*stride)return ArmSmmu4KUnsupported;
+    *gr1=stride;r->context_offset=(pages+bank)*stride;
+    if(r->context_offset>io->register_bytes || io->register_bytes-r->context_offset<0x7f8 ||
+        *gr1+0x804+bank*4>io->register_bytes)return ArmSmmu4KBadRange;
+    *actual=*config;actual->id0=r->id0;actual->id2=r->id2;
+    return ArmSmmu4KEncodeContext(actual,image);
+}
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;uint32_t sctlr;
+    if(io->read32(io->cookie,cb,&sctlr))return ArmSmmu4KIoError;
+    if(sctlr&1){r->enabled=1;return ArmSmmu4KBusy;}
+    r->must_retain_tables=1;r->phase=2;
+    /* A disabled owned bank only. TCR2/TCR precede all TTBR accesses. */
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) ||
+        write32(io,gr1+0x800+bank*4,image.cba2r,r) || write32(io,gr1+bank*4,image.cbar,r) ||
+        write32(io,cb+0x10,image.tcr2,r) || write32(io,cb+0x30,image.tcr,r) ||
+        write64(io,cb+0x20,image.ttbr0,r) || write64(io,cb+0x28,image.ttbr1,r) ||
+        write32(io,cb+0x38,image.mair0,r) || write32(io,cb+0x3c,image.mair1,r) ||
+        write32(io,cb+0x58,UINT32_MAX,r)) {status=ArmSmmu4KIoError;goto failed;}
+    status=sync_asid(io,cb,actual.asid,budget,r);if(status!=ArmSmmu4KSuccess)goto failed;
+    r->phase=3;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;
+    /* Verify configuration while M is still zero; never enable a bad granule. */
+    sctlr=r->readback.sctlr;r->readback.sctlr=image.sctlr;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;
+    if(status!=ArmSmmu4KSuccess || sctlr) {status=ArmSmmu4KStateMismatch;goto failed;}
+    r->readback_valid=0;
+    if(io->barrier(io->cookie) || write32(io,cb,image.sctlr,r) || io->barrier(io->cookie)) {status=ArmSmmu4KIoError;goto failed;}
+    r->phase=4;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    if(io->read32(io->cookie,cb+0x58,&r->fault_status)) {status=ArmSmmu4KIoError;goto failed;}
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);if(status!=ArmSmmu4KSuccess)goto failed;
+    if(r->fault_status&FSR_FAULT) {status=ArmSmmu4KFault;goto failed;}
+    r->phase=5;r->enabled=1;return ArmSmmu4KSuccess;
+failed:
+    /* Even a reported failed write may have reached hardware. On uncertainty
+     * retain all tables/leases; never claim safe recycling after timeout. */
+    r->readback_valid=0;(void)disable_sync(io,cb,actual.asid,budget,r);
+    r->phase=6;return status;
+}
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;r->must_retain_tables=1;
+    if(read_image(io,gr1,cb,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;uint32_t sctlr=r->readback.sctlr;
+    /* An enabled bank must match the owned image (ValidateContextReadback, with its documented read-only bits); a
+     * disabled one is compared with SCTLR substituted. */
+    if(sctlr)status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    else {r->readback.sctlr=image.sctlr;status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;}
+    if(status!=ArmSmmu4KSuccess)return status; /* Another context: do not touch. */
+    r->readback_valid=0;status=disable_sync(io,cb,actual.asid,budget,r);r->phase=status==ArmSmmu4KSuccess?7:6;
+    return status;
+}
+
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,1,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(read_image(io,gr1,(size_t)r->context_offset,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(io->read32(io->cookie,(size_t)r->context_offset+0x58,&r->fault_status) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    if(r->fault_status&FSR_FAULT)return ArmSmmu4KFault;
+    r->phase=8;return ArmSmmu4KSuccess;
+}
+
+static ArmSmmu4KStatus synchronize(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned all,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!budget || budget>1048576)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=ArmSmmu4KObserveOwnedContext(io,bank,config,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    status=sync_tlb(io,(size_t)r->context_offset,config->asid,all,budget,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    ArmSmmu4KProgramResult after;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,config,&after);
+    r->readback=after.readback;r->readback_valid=after.readback_valid;
+    r->fault_status=after.fault_status;r->enabled=after.enabled;
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(r->id0!=after.id0 || r->id1!=after.id1 || r->id2!=after.id2 ||
+        r->context_offset!=after.context_offset)return ArmSmmu4KStateMismatch;
+    r->phase=9;return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *io,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !budget || budget>1048576 || !context_offset ||
+        context_offset>io->register_bytes || io->register_bytes-context_offset<0x7f8)return ArmSmmu4KArgument;
+    r->context_offset=context_offset;
+    ArmSmmu4KStatus status=sync_tlb(io,(size_t)context_offset,asid,all,budget,r);
+    if(status==ArmSmmu4KSuccess)r->phase=9;
+    return status;
+}
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,0,budget,r);}
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,1,budget,r);}
diff --git a/bsd/dev/ArmSmmu4KStreams.h b/bsd/dev/ArmSmmu4KStreams.h
new file mode 100644
index 0000000..56d3d2e
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KStreams.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_STREAMS_H
+#define ARM_SMMU_4K_STREAMS_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {unsigned slot;uint16_t sid;} ArmSmmu4KStream;
+typedef struct {
+    unsigned attempted,attached,poisoned,count,bank;
+    uint32_t id0,scr0;
+    ArmSmmu4KStream streams[8];
+} ArmSmmu4KStreamState;
+typedef struct {
+    unsigned phase,reads,writes,streams_verified,streams_faulted,must_retain_resources;
+    uint32_t id0,scr0,global_fault;
+    ArmSmmu4KProgramResult context;
+} ArmSmmu4KStreamResult;
+/* Read-only preflight of global fault policy, target faulting slots and all
+ * conflicting live routes, including unrelated SIDs using the selected bank.
+ * Intended before programming a disabled context under the same global lease. */
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStream *,
+    unsigned count,unsigned bank,ArmSmmu4KStreamResult *);
+/* Native SMMUv2 exact stream matching (SMS), both legacy and EXIDS layouts.
+ * Caller owns the listed slots, bank/ASID, mappings and a global configuration
+ * lock. All client masters MUST remain quiesced until successful attachment.
+ * Requires live powered MMIO and installed context/global fault handlers,
+ * active native4K context/tables with verified physical ownership/coherence,
+ * and global fault-on-unmatched (no bypass). Global setup/quirks and context
+ * creation belong to the platform; no global reset or mask probing occurs.
+ * All target S2CRs must already fault; valid target SMRs must be exact matches.
+ * Every other active SMR is checked for overlapping requested SIDs. No masked
+ * attachment, bypass, privilege override, implicit slot selection or context
+ * reassignment is supported. Reads actual ID0 and enabled context registers.
+ * Inputs/state/result must be disjoint; state is zero-initialized and remains
+ * exclusively owned. Configuration/tables remain immutable while attached.
+ * Writes S2CR before publishing SMR; EXIDS keeps EXIDVALID clear until the
+ * exact SMR has been read back. Success rereads actual context/stream state.
+ * Any failure after a mutation attempt faults only the leased touched slots,
+ * poisons state and forbids replay. Resources are retained on EVERY outcome.
+ * Successful software I/O fixtures are not proof of active hardware tables. */
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,
+    const ArmSmmu4KStream *,unsigned count,unsigned bank,const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, checks all routes/conflicts/global fault policy and complete
+ * enabled native4K context image. No fault clear or recovery is synthesized. */
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, the global fault policy, the complete enabled native4K context
+ * image and the exact owned routes, without the scan of every other slot for
+ * conflicting routes: a fixed read count however many slots the SMMU has. A
+ * route another agent added later is only seen by ArmSmmu4KObserveStreams,
+ * which a caller observing this way must still run at a bounded interval. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Require exact owned active routes before changing them to FAULT. SMRs stay
+ * valid, so those SIDs remain blocked. Does not drain transactions/TLBs, stop
+ * devices, disable context, release ownership or authorize freeing tables.
+ * Failure poisons state; external real reset/recovery is required. */
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,ArmSmmu4KStreamResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/ArmSmmu4KStreams.c b/bsd/dev/ArmSmmu4KStreams.c
new file mode 100644
index 0000000..4450fdf
--- /dev/null
+++ b/bsd/dev/ArmSmmu4KStreams.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KStreams.h"
+#define FAULT (UINT32_C(2)<<16)
+static int rd(const ArmSmmu4KIo *io,size_t at,uint32_t *v,ArmSmmu4KStreamResult *r)
+{++r->reads;return io->read32(io->cookie,at,v);}
+static int wr(const ArmSmmu4KIo *io,size_t at,uint32_t v,ArmSmmu4KStreamResult *r)
+{++r->writes;return io->write32(io->cookie,at,v);}
+static unsigned exids(uint32_t id){return (id>>8)&1;}
+static uint32_t valid_smr(uint32_t id){return exids(id)?0:UINT32_C(1)<<31;}
+static uint32_t valid_s2cr(uint32_t id){return exids(id)?1u<<10:0;}
+static int valid(uint32_t id,uint32_t smr,uint32_t s2cr)
+{return exids(id)?!!(s2cr&(1u<<10)):!!(smr&(UINT32_C(1)<<31));}
+static ArmSmmu4KStatus global(const ArmSmmu4KIo *io,ArmSmmu4KStreamResult *r)
+{
+    if(!io || !io->read32 || !io->write32 || !io->barrier || io->register_bytes<0xc04)return ArmSmmu4KArgument;
+    if(rd(io,0x20,&r->id0,r) || rd(io,0,&r->scr0,r) || rd(io,0x48,&r->global_fault,r))return ArmSmmu4KIoError;
+    if(!(r->id0&(1u<<27)) || !(r->id0&255) || 0xc00u+4*(r->id0&255)>io->register_bytes)return ArmSmmu4KUnsupported;
+    /* Real global enable (CLIENTPD clear), global fault reporting (GFRE/GFIE) and unmatched-stream fault
+     * policy (USFCFG). Configuration-access fault reporting (GCFGFRE/GCFGFIE) is not required: Linux sets
+     * it only in its own global reset, and firmware that owns sCR0 may leave it clear (an Adreno SMMU read
+     * 0x002f0406). It reports bad register accesses, it does not change translation or bypass. */
+    if((r->scr0&0x407)!=0x406 || !!(r->scr0&8)!=exids(r->id0))return ArmSmmu4KStateMismatch;
+    return r->global_fault?ArmSmmu4KFault:ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus scan(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,unsigned n,
+    unsigned bank,unsigned attached,ArmSmmu4KStreamResult *r)
+{
+    unsigned slots=r->id0&255;uint32_t sidmask=exids(r->id0)?0xffffu:(1u<<((r->id0>>9)&15))-1;
+    for(unsigned i=0;i<n;++i) {
+        if(s[i].slot>=slots || (s[i].sid&~sidmask))return ArmSmmu4KArgument;
+        for(unsigned j=0;j<i;++j)if(s[i].slot==s[j].slot || s[i].sid==s[j].sid)return ArmSmmu4KOverlap;
+    }
+    r->streams_verified=0;
+    for(unsigned slot=0;slot<slots;++slot) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*slot,&smr,r) || rd(io,0xc00+4*slot,&s2cr,r))return ArmSmmu4KIoError;
+        unsigned own=n;
+        for(unsigned i=0;i<n;++i)if(s[i].slot==slot){own=i;break;}
+        if(own<n) {
+            unsigned live=valid(r->id0,smr,s2cr);
+            if(attached) {
+                if(smr!=(valid_smr(r->id0)|s[own].sid) || s2cr!=(bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+            } else if((s2cr&(3u<<16))!=FAULT ||
+                (live && smr!=(valid_smr(r->id0)|s[own].sid)))return ArmSmmu4KBusy;
+            ++r->streams_verified;
+        } else if(valid(r->id0,smr,s2cr)) {
+            if(!(s2cr&(3u<<16)) && (s2cr&255)==bank)return ArmSmmu4KBusy;
+            uint32_t mask=(smr>>16)&(exids(r->id0)?0xffffu:0x7fffu),id=smr&0xffff;
+            for(unsigned i=0;i<n;++i)if(!((s[i].sid^id)&~mask&sidmask))return ArmSmmu4KOverlap;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,
+    unsigned n,unsigned bank,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    return scan(io,s,n,bank,0,r);
+}
+static int quarantine(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *state,unsigned count,ArmSmmu4KStreamResult *r)
+{
+    r->streams_faulted=0;int failed=0;
+    for(unsigned i=0;i<count;++i) {
+        size_t at=0xc00+4*state->streams[i].slot;uint32_t value;
+        /* First stop translation. Only after confirmed FAULT may we restore
+         * the exact owned SID and make EXIDS matching valid again. This also
+         * handles an indeterminate/failed SMR publication without activating
+         * an old or corrupted SID from an initially invalid slot. */
+        size_t smr=0x800+4*state->streams[i].slot;
+        uint32_t match=valid_smr(state->id0)|state->streams[i].sid;
+        if(wr(io,at,FAULT,r) || io->barrier(io->cookie) || rd(io,at,&value,r) || (value&(3u<<16))!=FAULT ||
+            wr(io,smr,match,r) || io->barrier(io->cookie) || rd(io,smr,&value,r) || value!=match ||
+            wr(io,at,FAULT|valid_s2cr(state->id0),r) || io->barrier(io->cookie) ||
+            rd(io,at,&value,r) || (value&((3u<<16)|valid_s2cr(state->id0)))!=(FAULT|valid_s2cr(state->id0)))failed=1;
+        else ++r->streams_faulted;
+    }
+    return failed;
+}
+static ArmSmmu4KStatus observe(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    return observe(io,s,c,r);
+}
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    for(unsigned i=0;i<s->count;++i) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*s->streams[i].slot,&smr,r) || rd(io,0xc00+4*s->streams[i].slot,&s2cr,r))return ArmSmmu4KIoError;
+        if(smr!=(valid_smr(r->id0)|s->streams[i].sid) || s2cr!=(s->bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+        ++r->streams_verified;
+    }
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *state,
+    const ArmSmmu4KStream *s,unsigned n,unsigned bank,const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!state || !s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    if(state->attempted || state->attached || state->poisoned)return ArmSmmu4KBusy;
+    r->phase=1;ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->context);if(status)return status;
+    status=scan(io,s,n,bank,0,r);if(status)return status;
+    state->attempted=1;state->id0=r->id0;state->scr0=r->scr0;state->count=n;state->bank=bank;
+    for(unsigned i=0;i<n;++i)state->streams[i]=s[i];
+    unsigned touched=0;r->phase=2;
+    for(unsigned i=0;i<n;++i) {
+        uint32_t value;size_t smr=0x800+4*s[i].slot,s2cr=0xc00+4*s[i].slot;
+        touched=i+1;
+        /* In EXIDS mode make this leased slot invalid until its new SID is
+         * installed. All masters are quiesced, and unmatched SIDs fault. */
+        if(wr(io,s2cr,bank,r) || io->barrier(io->cookie) || rd(io,s2cr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=bank){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(wr(io,smr,valid_smr(r->id0)|s[i].sid,r) || io->barrier(io->cookie) || rd(io,smr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=(valid_smr(r->id0)|s[i].sid)){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(exids(r->id0) && (wr(io,s2cr,bank|valid_s2cr(r->id0),r) || io->barrier(io->cookie))) {status=ArmSmmu4KIoError;goto failed;}
+    }
+    r->phase=3;status=observe(io,state,c,r);if(status)goto failed;
+    state->attached=1;r->phase=4;return ArmSmmu4KSuccess;
+failed:
+    state->poisoned=1;state->attached=0;r->phase=5;
+    (void)quarantine(io,state,touched,r);return status;
+}
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *s,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    r->phase=6;
+    if(quarantine(io,s,s->count,r)){s->poisoned=1;s->attached=0;return ArmSmmu4KIoError;}
+    s->attached=0;r->phase=7;return ArmSmmu4KSuccess;
+}
diff --git a/bsd/dev/surya_unixnu_smmu.h b/bsd/dev/surya_unixnu_smmu.h
new file mode 100644
index 0000000..e0dc7b8
--- /dev/null
+++ b/bsd/dev/surya_unixnu_smmu.h
@@ -0,0 +1,34 @@
+/* UniXNU ArmSmmu4K integration for SURYA. Live context and stream routing. */
+#ifndef SURYA_UNIXNU_SMMU_H
+#define SURYA_UNIXNU_SMMU_H
+#include "ArmSmmu4KContext.h"
+
+struct surya_unixnu_smmu_report {
+    uint32_t memnoc_before, memnoc_after, id0, id1, id2, scr0;
+    uint32_t cb_sctlr, cb_fsr, cb_tcr, cb_offset;
+    uint64_t cb_ttbr0;
+    unsigned table_pages, leaves, clocks_ready;
+    int stage, code;
+    uint32_t active_sctlr, active_fsr, smr0, s2cr0;
+    unsigned context_enabled, streams_attached;
+};
+
+/* Decode real ID1 before touching a context bank. This only authorizes reads
+ * inside the mapping, never a bank lease, activation or a stream reassignment. */
+static inline int
+surya_unixnu_cb0(uint32_t id1, size_t bytes, uint32_t *offset)
+{
+    if (!offset) return 1;
+    *offset = 0;
+    unsigned shift = (id1 >> 31) ? 16 : 12;
+    size_t pages = (size_t)1 << (((id1 >> 28) & 7) + 1);
+    size_t stride = (size_t)1 << shift;
+    unsigned banks = id1 & 255, s2 = (id1 >> 16) & 255;
+    if (!banks || banks > pages || s2 > banks || s2 != 0 ||
+        bytes < 2 * pages * stride) return 1;
+    *offset = (uint32_t)(pages * stride);
+    return 0;
+}
+
+void surya_unixnu_smmu_capture(struct surya_unixnu_smmu_report *);
+#endif
diff --git a/bsd/dev/surya_unixnu_smmu.c b/bsd/dev/surya_unixnu_smmu.c
new file mode 100644
index 0000000..24fe67e
--- /dev/null
+++ b/bsd/dev/surya_unixnu_smmu.c
@@ -0,0 +1,288 @@
+/* SURYA bridge to pinned UniXNU ArmSmmu4K: live context & stream attachment.
+ * DT-ordered KGSL clocks use branch definitions from the matching driver.
+ */
+#if defined(ARM64_BOARD_CONFIG_SURYA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include "surya_unixnu_smmu.h"
+#include "surya_gpu_dt.h"
+#include "ArmSmmu4KProgram.h"
+#include "ArmSmmu4KStreams.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+
+static uint32_t read32(vm_offset_t base, unsigned off)
+{
+    uint32_t value = *(volatile uint32_t *)(base + off);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static uint64_t read64(vm_offset_t base, unsigned off)
+{
+    uint64_t value = *(volatile uint64_t *)(base + off);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static int io_read32(void *cookie, size_t at, uint32_t *out)
+{
+    vm_offset_t base = (vm_offset_t)cookie;
+    *out = read32(base, (unsigned)at);
+    return 0;
+}
+
+static int io_read64(void *cookie, size_t at, uint64_t *out)
+{
+    vm_offset_t base = (vm_offset_t)cookie;
+    *out = read64(base, (unsigned)at);
+    return 0;
+}
+
+static int io_write32(void *cookie, size_t at, uint32_t val)
+{
+    vm_offset_t base = (vm_offset_t)cookie;
+    *(volatile uint32_t *)(base + at) = val;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    return 0;
+}
+
+static int io_write64(void *cookie, size_t at, uint64_t val)
+{
+    vm_offset_t base = (vm_offset_t)cookie;
+    *(volatile uint64_t *)(base + at) = val;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    return 0;
+}
+
+static int io_barrier(void *cookie)
+{
+    (void)cookie;
+    __asm__ volatile("dsb osh; isb" ::: "memory");
+    return 0;
+}
+
+static int live_tables(struct surya_unixnu_smmu_report *r, vm_offset_t smmu)
+{
+    vm_offset_t tables = 0, data = 0;
+    if (PAGE_SIZE != 16384) return 100;
+    if (kmem_alloc_contig(kernel_map, &tables, 16384, PAGE_MASK, 0, 0,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+        return 101;
+    if (kmem_alloc_contig(kernel_map, &data, 16384, PAGE_MASK, 0, 0,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+        return 102;
+    ppnum_t tp = pmap_find_phys(kernel_pmap, (addr64_t)tables);
+    ppnum_t dp = pmap_find_phys(kernel_pmap, (addr64_t)data);
+    if (!tp || !dp) return 103;
+    const uint64_t physical = ptoa_64(tp), data_physical = ptoa_64(dp);
+    const uint64_t iova = UINT64_C(0x100000000);
+    ArmSmmu4KConfig config = {39, 36, physical, 4};
+    ArmSmmu4KRange range = {iova, data_physical, 16384,
+        ArmSmmu4KRead | ArmSmmu4KWrite, 0, 2};
+    ArmSmmu4KResult built = {0};
+    ArmSmmu4KStatus status = ArmSmmu4KBuild(&config, &range, 1,
+        (uint64_t *)tables, 4, &built);
+    if (status) return status;
+    r->table_pages = (unsigned)built.table_pages;
+    r->leaves = (unsigned)built.leaf_pages;
+    /* Independent CPU walk over the actual newly allocated descriptors. */
+    for (unsigned off = 0; off < 16384; ++off) {
+        uint64_t table = physical, descriptor = 0;
+        for (unsigned shift = 30; ; shift -= 9) {
+            if (table < physical || table - physical >= 16384 || (table & 4095))
+                return 104;
+            descriptor = ((uint64_t *)tables)[(table - physical) / 8 +
+                (((iova + off) >> shift) & 511)];
+            if ((descriptor & 3) != 3) return 105;
+            if (shift == 12) break;
+            table = descriptor & UINT64_C(0x0000fffffffff000);
+        }
+        if ((descriptor & UINT64_C(0x0000fffffffff000)) + (off & 4095) !=
+            data_physical + off) return 106;
+    }
+
+    /* Clean cache to Point of Coherency (PoC) for table memory so SMMU hardware walker sees descriptors in DDR */
+    for (uintptr_t p = (uintptr_t)tables; p < (uintptr_t)tables + 16384; p += 64) {
+        __asm__ volatile("dc cvac, %0" : : "r"(p) : "memory");
+    }
+    __asm__ volatile("dsb sy; isb" ::: "memory");
+
+    /* Populate test data buffer with sentinel pattern */
+    *(volatile uint64_t *)data = 0xCAFEBABEDEADBEEFULL;
+    for (uintptr_t p = (uintptr_t)data; p < (uintptr_t)data + 16384; p += 64) {
+        __asm__ volatile("dc cvac, %0" : : "r"(p) : "memory");
+    }
+    __asm__ volatile("dsb sy; isb" ::: "memory");
+
+    ArmSmmu4KContextConfig context = {0};
+    context.lower = &config;
+    context.lower_tables = &built;
+    context.id0 = r->id0; context.id2 = r->id2;
+    context.asid = 1;
+    context.stall_on_fault = 0;
+    context.continue_after_fault = 1;
+    context.coherent_walk = 0;
+
+    ArmSmmu4KIo io = {
+        .cookie = (void *)smmu,
+        .register_bytes = SURYA_DT_SMMU_SIZE,
+        .read32 = io_read32,
+        .read64 = io_read64,
+        .write32 = io_write32,
+        .write64 = io_write64,
+        .barrier = io_barrier,
+    };
+
+    printf("SURYA UNIXNU STEP 12: program and activate context bank 0\n");
+    delay(20000);
+    ArmSmmu4KProgramResult prog_res = {0};
+    ArmSmmu4KStatus prog_status = ArmSmmu4KProgramDisabledContext(&io, 0, &context, 10000, &prog_res);
+    printf("SURYA UNIXNU PROG: status=%d phase=%u enabled=%u writes=%u fault=%#x\n",
+        prog_status, prog_res.phase, prog_res.enabled, prog_res.writes, prog_res.fault_status);
+    delay(20000);
+    if (prog_status != ArmSmmu4KSuccess) return 30 + (int)prog_status;
+
+    r->active_sctlr = read32(smmu, r->cb_offset);
+    r->active_fsr = read32(smmu, r->cb_offset + 0x58);
+    r->context_enabled = prog_res.enabled;
+    printf("SURYA UNIXNU STEP 13: CB0 SCTLR=%#x FSR=%#x (%s)\n",
+        r->active_sctlr, r->active_fsr, r->context_enabled ? "ACTIVE" : "INACTIVE");
+    delay(20000);
+
+    printf("SURYA UNIXNU STEP 14: attach GPU stream %llu to context bank 0\n", SURYA_DT_USER_SID);
+    delay(20000);
+
+    /* Pre-attach requirement: slot 0 S2CR set to FAULT */
+    io_write32((void *)smmu, 0xc00 + 0 * 4, 2u << 16);
+    io_barrier(NULL);
+
+    ArmSmmu4KStream stream = { .slot = 0, .sid = (uint16_t)SURYA_DT_USER_SID };
+    ArmSmmu4KStreamState stream_state = {0};
+    ArmSmmu4KStreamResult stream_res = {0};
+    ArmSmmu4KStatus attach_status = ArmSmmu4KAttachStreams(&io, &stream_state, &stream, 1, 0, &context, &stream_res);
+    printf("SURYA UNIXNU ATTACH: status=%d verified=%u writes=%u\n",
+        attach_status, stream_res.streams_verified, stream_res.writes);
+    delay(20000);
+
+    r->smr0 = read32(smmu, 0x800 + 0 * 4);
+    r->s2cr0 = read32(smmu, 0xc00 + 0 * 4);
+    if (attach_status != ArmSmmu4KSuccess) return 40 + (int)attach_status;
+    r->streams_attached = stream_state.attached;
+    printf("SURYA UNIXNU STEP 15: SMR0=%#x S2CR0=%#x (%s)\n",
+        r->smr0, r->s2cr0, r->streams_attached ? "ATTACHED" : "UNATTACHED");
+    delay(20000);
+
+    return 0;
+}
+
+static int prepare_dt_clocks(struct surya_unixnu_smmu_report *r)
+{
+    const uint32_t ids[] = {SURYA_DT_IOMMU_CLK0_ID, SURYA_DT_IOMMU_CLK1_ID, SURYA_DT_IOMMU_CLK2_ID};
+    const uint32_t offsets[] = {SURYA_DT_IOMMU_CLK0_OFFSET, SURYA_DT_IOMMU_CLK1_OFFSET, SURYA_DT_IOMMU_CLK2_OFFSET};
+    const uint32_t masks[] = {SURYA_DT_IOMMU_CLK0_MASK, SURYA_DT_IOMMU_CLK1_MASK, SURYA_DT_IOMMU_CLK2_MASK};
+    printf("SURYA DT CLOCKS: map captured GCC=%#llx size=%#llx\n", SURYA_DT_GCC_PA, SURYA_DT_GCC_SIZE);
+    delay(20000);
+    vm_offset_t gcc = ml_io_map(SURYA_DT_GCC_PA, SURYA_DT_GCC_SIZE);
+    if (!gcc) return 10;
+    for (unsigned i = 0; i < 3; ++i) {
+        printf("SURYA DT CLOCK %u: ID=%u read branch=%#llx\n", i, ids[i], SURYA_DT_GCC_PA + offsets[i]);
+        delay(20000);
+        r->memnoc_before = read32(gcc, offsets[i]);
+        if (r->memnoc_before == UINT32_MAX || r->memnoc_before == 0xdeafbead) return 11 + i;
+        __asm__ volatile("dmb oshst" ::: "memory");
+        *(volatile uint32_t *)(gcc + offsets[i]) = r->memnoc_before | masks[i];
+        __asm__ volatile("dsb osh" ::: "memory");
+        for (unsigned poll = 0; poll < 5000; ++poll) {
+            r->memnoc_after = read32(gcc, offsets[i]);
+            if (!(r->memnoc_after & (1u << 31))) break;
+            delay(1);
+        }
+        printf("SURYA DT CLOCK %u: before=%#x after=%#x\n", i, r->memnoc_before, r->memnoc_after);
+        delay(20000);
+        if ((r->memnoc_after & (1u << 31)) || !(r->memnoc_after & masks[i])) return 21 + i;
+        r->clocks_ready |= 1u << i;
+    }
+
+    printf("SURYA DT GPUCC: map captured GPUCC=%#llx size=%#llx\n", SURYA_DT_GPUCC_PA, SURYA_DT_GPUCC_SIZE);
+    delay(20000);
+    vm_offset_t gpucc = ml_io_map(SURYA_DT_GPUCC_PA, SURYA_DT_GPUCC_SIZE);
+    if (!gpucc) return 14;
+    uint32_t smmu_vote = read32(gpucc, 0x5000);
+    printf("SURYA DT GPUCC: SMMU vote branch before=%#x\n", smmu_vote);
+    delay(20000);
+    *(volatile uint32_t *)(gpucc + 0x5000) = smmu_vote | 1u;
+    __asm__ volatile("dsb osh" ::: "memory");
+    smmu_vote = read32(gpucc, 0x5000);
+    printf("SURYA DT GPUCC: SMMU vote branch after=%#x\n", smmu_vote);
+    delay(20000);
+    if (!(smmu_vote & 1u)) return 24;
+    r->clocks_ready |= 1u << 3;
+
+    return 0;
+}
+
+void
+surya_unixnu_smmu_capture(struct surya_unixnu_smmu_report *r)
+{
+    *r = (struct surya_unixnu_smmu_report){0};
+    r->stage = 1;
+    r->code = prepare_dt_clocks(r);
+    if (r->code) return;
+    printf("SURYA UNIXNU STEP 4: KGSL DT clocks ready; read-only SMMU probe\n");
+    delay(20000);
+    printf("SURYA DT: SMMU=%#llx bytes=%#llx userSID=%llu secureSID=%llu CB=%#llx\n",
+        SURYA_DT_SMMU_PA, SURYA_DT_SMMU_SIZE, SURYA_DT_USER_SID,
+        SURYA_DT_SECURE_SID, SURYA_DT_USER_CB_OFFSET);
+    printf("SURYA DT: GCC=%#llx MEMNOC clock ID=%llu (clock plan)\n",
+        SURYA_DT_GCC_PA, SURYA_DT_MEMNOC_CLOCK_ID);
+    r->stage = 2;
+    vm_offset_t smmu = ml_io_map(SURYA_DT_SMMU_PA, SURYA_DT_SMMU_SIZE);
+    if (!smmu) {r->code = 4; return;}
+    ppnum_t mapped = pmap_find_phys(kernel_pmap, (addr64_t)smmu);
+    uint64_t translated = ptoa_64(mapped) + (smmu & PAGE_MASK);
+    printf("SURYA SMMU CPU MAP: VA=%#llx PA=%#llx expected=%#llx\n",
+        (uint64_t)smmu, translated, SURYA_DT_SMMU_PA);
+    delay(20000);
+    if (!mapped || translated != SURYA_DT_SMMU_PA) {r->code = 6; return;}
+    printf("SURYA UNIXNU STEP 5: read ID0 at 0x5040020\n");
+    delay(20000);
+    r->id0 = read32(smmu, 0x20);
+    printf("SURYA UNIXNU STEP 6: ID0=%#x; read ID1\n", r->id0);
+    delay(20000);
+    r->id1 = read32(smmu, 0x24);
+    printf("SURYA UNIXNU STEP 7: ID1=%#x; read ID2\n", r->id1);
+    delay(20000);
+    r->id2 = read32(smmu, 0x28);
+    printf("SURYA UNIXNU STEP 8: ID2=%#x; read SCR0\n", r->id2);
+    delay(20000);
+    r->scr0 = read32(smmu, 0);
+    if (surya_unixnu_cb0(r->id1, SURYA_DT_SMMU_SIZE, &r->cb_offset) ||
+        r->cb_offset != SURYA_DT_USER_CB_OFFSET) {
+        r->code = 5; return;
+    }
+    printf("SURYA UNIXNU STEP 9: SCR0=%#x; read CB0 off=%#x\n", r->scr0, r->cb_offset);
+    delay(20000);
+    r->stage = 3;
+    r->cb_sctlr = read32(smmu, r->cb_offset);
+    r->cb_fsr = read32(smmu, r->cb_offset + 0x58);
+    r->cb_tcr = read32(smmu, r->cb_offset + 0x30);
+    printf("SURYA UNIXNU STEP 10: SCTLR=%#x FSR=%#x; read TTBR0\n", r->cb_sctlr, r->cb_fsr);
+    delay(20000);
+    r->cb_ttbr0 = read64(smmu, r->cb_offset + 0x20);
+    printf("SURYA UNIXNU STEP 11: CB0 read; build & activate live tables\n");
+    delay(20000);
+    r->stage = 4;
+    r->code = live_tables(r, smmu);
+    if (!r->code) {
+        r->stage = 5;
+        if (r->context_enabled) r->stage = 6;
+        if (r->streams_attached) r->stage = 7;
+    }
+}
+#endif
