 /* Copy each enabled layer's surface into the panel memory (no scaling). */
+/* Fast 64-byte chunk burst-write copy to write-combined / panel memory */
+static inline void
+sweet_fast_copy_row(void *dst, const void *src, size_t bytes)
+{
+	uint8_t *d = (uint8_t *)dst;
+	const uint8_t *s = (const uint8_t *)src;
+	size_t chunks64 = bytes >> 6; /* 64 bytes per chunk */
+	while (chunks64--) {
+		asm volatile(
+			"ldp x8, x9, [%0], #16\n"
+			"ldp x10, x11, [%0], #16\n"
+			"ldp x12, x13, [%0], #16\n"
+			"ldp x14, x15, [%0], #16\n"
+			"stp x8, x9, [%1], #16\n"
+			"stp x10, x11, [%1], #16\n"
+			"stp x12, x13, [%1], #16\n"
+			"stp x14, x15, [%1], #16\n"
+			: "+r"(s), "+r"(d)
+			:
+			: "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "memory"
+		);
+	}
+	size_t chunks32 = (bytes & 63) >> 5;
+	while (chunks32--) {
+		asm volatile(
+			"ldp x8, x9, [%0], #16\n"
+			"ldp x10, x11, [%0], #16\n"
+			"stp x8, x9, [%1], #16\n"
+			"stp x10, x11, [%1], #16\n"
+			: "+r"(s), "+r"(d)
+			:
+			: "x8", "x9", "x10", "x11", "memory"
+		);
+	}
+	size_t rem = (bytes & 31) >> 3;
+	while (rem--) {
+		*(uint64_t *)d = *(const uint64_t *)s;
+		s += 8;
+		d += 8;
+	}
+	size_t tail = bytes & 7;
+	while (tail--) {
+		*d++ = *s++;
+	}
+}
