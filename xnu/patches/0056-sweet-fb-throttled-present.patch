 static uint64_t sweet_fb_swap_count;
 
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
+/* Fast 32-byte chunk burst-write copy to write-combined / panel memory */
+static inline void
+sweet_fast_copy_row(void *dst, const void *src, size_t bytes)
+{
+	uint8_t *d = (uint8_t *)dst;
+	const uint8_t *s = (const uint8_t *)src;
+	size_t chunks = bytes >> 5; /* 32 bytes per chunk */
+	while (chunks--) {
+		asm volatile(
+			"ldp x8, x9, [%0], #16\n"
+			"ldp x10, x11, [%0], #16\n"
+			"stp x8, x9, [%1], #16\n"
+			"stp x10, x11, [%1], #16\n"
+			: "+r"(s), "+r"(d)
+			:
+			: "x8", "x9", "x10", "x11", "memory"
+		);
+	}
+	size_t rem = (bytes & 31) >> 3;
+	while (rem--) {
+		*(uint64_t *)d = *(const uint64_t *)s;
+		s += 8;
+		d += 8;
+	}
+	size_t tail = bytes & 7;
+	while (tail--) {
+		*d++ = *s++;
+	}
+}
+
+/*
+ * A swap records the frame: presentation flushes at 60 Hz (sweetfb_hz boot-arg)
+ * using 32-byte burst transfers directly to write-combined panel RAM.
+ */
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	IOLockLock(fLock);
+	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
+	fDirty = true;
+	IOLockUnlock(fLock);
+	if ((++sweet_fb_swap_count % 1000) == 0) {
+		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+	}
+}
